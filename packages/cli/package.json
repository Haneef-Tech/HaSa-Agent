{
  "name": "hasa-agent",
  "version": "0.1.0",
  "description": "HASA terminal coding agent (BYOK free models: Nara, Zen, Gemini, Groq) — thin client over hasa-core",
  "type": "module",
  "bin": {
    "hasa": "./dist/index.js"
  },
  "files": ["dist", "keybindings.json"],
  "keywords": ["ai", "coding-agent", "cli", "nara", "gemini", "byok"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.tsx",
    "test": "echo \"cli: no tests yet\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "hasa-core": "0.1.0",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "license": "MIT"
}

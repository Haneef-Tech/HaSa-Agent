{
  "name": "hasa-vscode-ext",
  "displayName": "HASA Coding Agent",
  "description": "Local-first AI coding agent (BYOK free models). Thin client over hasa-core.",
  "version": "0.1.0",
  "publisher": "hasa",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=18"
  },
  "categories": ["AI", "Chat"],
  "activationEvents": [
    "onCommand:hasa.openChat",
    "onCommand:hasa.setup",
    "onCommand:hasa.showDiff"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "echo \"ext: no tests yet\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npx @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "contributes": {
    "commands": [
      { "command": "hasa.setup", "title": "HASA: Setup API Key & Model" },
      { "command": "hasa.openChat", "title": "HASA: Open Chat" },
      { "command": "hasa.showDiff", "title": "HASA: Show Diff" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "hasa", "title": "HASA", "icon": "resources/icon.svg" }]
    },
    "views": {
      "hasa": [{ "id": "hasa.chat", "name": "HASA Chat", "type": "webview" }]
    },
    "configuration": {
      "title": "HASA",
      "properties": {
        "hasa.provider": { "type": "string", "default": "nara", "description": "Model provider id" },
        "hasa.model": { "type": "string", "default": "", "description": "Model id (empty = config default)" }
      }
    }
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/vscode": "^1.93.0",
    "typescript": "^5.6.2"
  }
}

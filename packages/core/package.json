{
  "name": "hasa-core",
  "version": "0.1.0",
  "description": "HASA shared core engine — providers, agent loop, tools, session, permissions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.2",
    "vitest": "^2.1.3",
    "@types/node": "^20.16.0"
  },
  "license": "MIT"
}
